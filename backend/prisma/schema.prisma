generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}
enum ProductType {
  SERVICE
  GOODS
}
enum BillingCycle {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}
enum DiscountType {
  FIXED
  PERCENTAGE
}
enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  OTHER
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  email           String       @unique
  passwordHash    String
  role            Role         @default(CUSTOMER)
  resetTokenHash  String?      @unique
  resetTokenUntil DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  customer        Customer?
}

model Customer {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phone       String?
  userId      String?        @unique @db.Uuid
  odooPartnerId String?
  createdAt   DateTime       @default(now())
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  invoices    Invoice[]
  @@index([email])
}

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  type        ProductType
  salesPrice  Decimal         @db.Decimal(12, 2)
  costPrice   Decimal?        @db.Decimal(12, 2)
  notes       String?
  odooProductId String?
  createdAt   DateTime        @default(now())
  variants    ProductVariant[]
  items       SubscriptionItem[]
  invoiceItems InvoiceItem[]
  discounts   DiscountProduct[]
}

model ProductVariant {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @db.Uuid
  name       String
  extraPrice Decimal @db.Decimal(12, 2)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model Plan {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  price          Decimal      @db.Decimal(12, 2)
  billingCycle   BillingCycle
  minimumQuantity Int         @default(1)
  availableFrom  DateTime?
  availableTo    DateTime?
  autoClose      Boolean      @default(false)
  allowPause     Boolean      @default(true)
  allowRenewal   Boolean      @default(true)
  subscriptions  Subscription[]
}

model QuotationTemplate {
  id String @id @default(uuid()) @db.Uuid
  name String
  validityDays Int
  description String?
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  subscriptionNumber String             @unique
  customerId         String             @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(DRAFT)
  startDate          DateTime
  expiryDate         DateTime?
  nextBillingDate    DateTime?
  paymentTerms       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  customer           Customer           @relation(fields: [customerId], references: [id])
  plan               Plan               @relation(fields: [planId], references: [id])
  items              SubscriptionItem[]
  discounts          SubscriptionDiscount[]
  invoices           Invoice[]
  @@index([status, nextBillingDate])
  @@index([customerId])
}

model SubscriptionItem {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  productId      String       @db.Uuid
  quantity       Int
  unitPrice      Decimal      @db.Decimal(12, 2)
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])
}

model Discount {
  id               String       @id @default(uuid()) @db.Uuid
  name             String
  type             DiscountType
  value            Decimal      @db.Decimal(12, 2)
  minimumQuantity  Int          @default(1)
  minimumPurchase  Decimal?     @db.Decimal(12, 2)
  startDate        DateTime?
  endDate          DateTime?
  usageLimit       Int?
  usedCount        Int          @default(0)
  active           Boolean      @default(true)
  products         DiscountProduct[]
  subscriptions    SubscriptionDiscount[]
}

model DiscountProduct {
  discountId String @db.Uuid
  productId  String @db.Uuid
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([discountId, productId])
}

model SubscriptionDiscount {
  subscriptionId String @db.Uuid
  discountId     String @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  discount       Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  @@id([subscriptionId, discountId])
}

model TaxRule {
  id String @id @default(uuid()) @db.Uuid
  name String
  percentage Decimal @db.Decimal(5, 2)
  active Boolean @default(true)
  odooTaxId String?
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique
  customerId     String        @db.Uuid
  subscriptionId String?       @db.Uuid
  odooInvoiceId  String?
  billingPeriod  String?
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime
  createdAt      DateTime      @default(now())
  customer       Customer      @relation(fields: [customerId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]
  @@unique([subscriptionId, billingPeriod])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  productId   String? @db.Uuid
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceId      String        @db.Uuid
  odooPaymentId  String?
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  paidAt         DateTime      @default(now())
  note           String?
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
}

model IntegrationLog {
  id String @id @default(uuid()) @db.Uuid
  provider String
  operation String
  entityType String
  entityId String?
  externalId String?
  status String
  errorMessage String?
  createdAt DateTime @default(now())
}
